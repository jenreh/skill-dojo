
{
  "extraKnownMarketplaces": {
    "jenreh": {
      "source": {
        "source": "github",
        "repo": "jenreh/agent-skills"
      }
    }
  },
  "enabledPlugins": {
    "jenreh-core@jenreh": true,
    "jenreh-python@jenreh": true,
    "jenreh-tools@jenreh": true,
    "jenreh-design@jenreh": true,
    "jenreh-reflex@jenreh": true
  },
  "permissions": {
    "allow": [
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv lock)",
      "Bash(uv lock *)",
      "Bash(uv tree)",
      "Bash(uv tree *)",
      "Bash(uv audit)",
      "Bash(uv audit *)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run ty *)",
      "Bash(git stash *)",
      "Bash(task)",
      "Bash(task --list)",
      "Bash(task test)",
      "Bash(task test *)",
      "Bash(task lint)",
      "Bash(task format)",
      "Bash(task typecheck)",
      "Bash(task audit)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Skill(jenreh-tools:create-readme)",
      "Skill(jenreh-python:python-coding)",
      "Skill(jenreh-design:frontend-design)",
      "Skill(jenreh-design:ui-ux-pro-max)",
      "Skill(jenreh-design:design-system)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.docker)",
      "Read(./.env.local)",
      "Read(./.env.prod)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfvars)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.ssh/**)"
    ]
  }
}
