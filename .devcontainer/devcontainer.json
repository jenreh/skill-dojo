// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "skit-dev",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"remoteUser": "vscode",
	"workspaceFolder": "/workspaces/skit",
	"containerEnv": {
		"WORKSPACE": "/workspaces/skit",
		"UV_PROJECT_ENVIRONMENT": ".venv",
		"VIRTUAL_ENV": "/workspaces/skit/.venv",
		// The uv cache volume and the workspace are different filesystems
		"UV_LINK_MODE": "copy",
		// Keep .claude.json inside the persisted ~/.claude volume
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
	},
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"python.envFile": "${workspaceFolder}/.env"
			},
			"extensions": [
				"-dbaeumer.vscode-eslint",
				"-ms-python.autopep8", // disabled because we are using ruff
				"Anthropic.claude-code",
				"astral-sh.ty",
				"charliermarsh.ruff",
				"esbenp.prettier-vscode",
				"fill-labs.dependi",
				"GitHub.remotehub",
				"github.vscode-github-actions",
				"GitHub.vscode-pull-request-github",
				"humao.rest-client",
				"ms-ossdata.vscode-pgsql",
				"ms-python.python",
				"mutantdino.resourcemonitor",
				"naumovs.color-highlight",
				"redhat.vscode-yaml",
				"sndst00m.vscode-native-svg-preview",
				"tamasfe.even-better-toml",
				"teticio.python-envy",
				"Upstash.context7-mcp",
				"vscode-icons-team.vscode-icons",
				"yzhang.markdown-all-in-one"
			]
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2.7.1": {
			"configureZshAsDefaultShell": true,
			"installOhMyZsh": false,
			"installOhMyZshConfig": false,
			"username": "vscode"
		},
		"ghcr.io/devcontainers/features/git:1.3.8": {},
		"ghcr.io/devcontainers/features/github-cli:1.1.3": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {},
		"ghcr.io/devcontainers/features/node:2.1.2": {
			"version": "24"
		}
	},
	"postCreateCommand": {
		"initialize environment": "bash ./.devcontainer/post-create.sh"
	},
	"postAttachCommand": {
		"install dependencies": "uv sync",
		"install agent plugins": "task agents:plugins"
	}
}
